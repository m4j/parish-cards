# Copy to .env. Compose reads this file for the settings below.
# .env is not committed.

# HTTPS port published on the host and used by nginx. Port 80 redirects here.
SSL_PORT=443

# Certificate and private key paths inside the nginx container.
# These default to the snakeoil pair built into the image.
SSL_CERTIFICATE=/etc/ssl/certs/ssl-cert-snakeoil.pem
SSL_CERTIFICATE_KEY=/etc/ssl/private/ssl-cert-snakeoil.key

# Host directory mounted at /etc/nginx/ssl. To use your own certificate,
# put the files here and set the two paths above to /etc/nginx/ssl/<file>.
SSL_CERT_DIR=./certs

# Host directory that contains StJohnDC.db. The container always opens
# /data/StJohnDC.db. ".." is the directory next to this repo, which is
# where the Makefile already keeps the database. Set this to ./data
# and copy the file there if the container should see only that file.
CARDS_DATABASE_DIR=..

CARDS_DATABASE_URI=sqlite:////data/StJohnDC.db
SECRET_KEY=replace-with-a-long-random-string

# nginx terminates TLS and sets X-Forwarded-Proto.
BEHIND_PROXY=1

# Serve Bootstrap from the app instead of a CDN.
BOOTSTRAP_SERVE_LOCAL=1

CARDS_LOG_LEVEL=INFO
CARDS_DB_LOG_LEVEL=WARNING

# Optional file log. Leave unset to log to the container stdout.
# CARDS_LOG=/var/log/parish-cards/parish.log

# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=330
